<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".VpnApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VPN"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <activity
            android:name=".ui.LoginActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:theme="@style/Theme.VPN.NoActionBar"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- ФИЛЬТР ДЛЯ ОТКРЫТИЯ ФАЙЛОВ ПО РАСШИРЕНИЮ -->
            <intent-filter>
                <!-- Действие: просмотр содержимого файла -->
                <action android:name="android.intent.action.VIEW" />
                <!-- Обязательные категории для обработки файлов -->
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!-- Указываем, что работаем с контентом и файлами -->
                <data android:scheme="content" />
                <data android:scheme="file" />

                <!-- Разрешаем любые MIME-типы, чтобы система передала нам файл -->
                <data android:mimeType="*/*" />
                <data android:host="*" />

                <!-- Шаблон для поиска файлов с вашим расширением -->
                <!-- Замените "ваше_расширение" на нужное, например "vpn" или "ovpn" -->
                <data android:pathPattern=".*\\.ovpn" />
                <data android:pathPattern=".*\\..*\\.ovpn" />
                <data android:pathPattern=".*\\..*\\..*\\.ovpn" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/.ovpn" /> <!-- или "*/*" -->
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RegisterActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false"
            android:theme="@style/Theme.VPN.NoActionBar"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".ui.EmailConfirmationActivity"
            android:exported="false"
            android:theme="@style/Theme.VPN.NoActionBar"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.VPN.NoActionBar"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".ui.AdminActivity"
            android:exported="false"
            android:theme="@style/Theme.VPN.NoActionBar"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.VPN.NoActionBar"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".ui.LegalDocumentActivity"
            android:exported="false"
            android:theme="@style/Theme.VPN.NoActionBar"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".ui.SubscriptionActivity"
            android:exported="false"
            android:theme="@style/Theme.VPN.NoActionBar"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".ui.AccountActivity"
            android:exported="false"
            android:theme="@style/Theme.VPN.NoActionBar"
            android:screenOrientation="portrait"/>
<!--            <intent-filter>-->
<!--                <action android:name="android.intent.action.VIEW" />-->
<!--                <category android:name="android.intent.category.DEFAULT" />-->
<!--                <category android:name="android.intent.category.BROWSABLE" />-->
<!--                <data android:scheme="vpnapp" android:host="payment-result" />-->
<!--            </intent-filter>-->
        <activity
            android:name=".ui.ConfigSelectionActivity"
            android:exported="true"
            android:theme="@style/Theme.VPN.NoActionBar"
            android:screenOrientation="portrait">
            <!-- Открытие .ovpn и .conf файлов из сторонних приложений -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.ovpn" />
                <data android:pathPattern=".*\\..*\\.ovpn" />
                <data android:pathPattern=".*\\.conf" />
                <data android:pathPattern=".*\\..*\\.conf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PaymentWebViewActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.VPN.NoActionBar"
            android:screenOrientation="portrait"/>

        <!-- Keep the component used by OpenVPN PendingIntents, execute without a dialog. -->
        <activity
            android:name=".ui.VpnNotificationActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="de.blinkt.openvpn.activities.DisconnectVPN"
            tools:node="remove" />
        <activity-alias
            android:name="de.blinkt.openvpn.activities.DisconnectVPN"
            android:targetActivity=".ui.VpnNotificationActionActivity"
            android:exported="false" />

        <!-- Library components: add android:exported required since targetSdk 31+ -->
        <activity
            android:name="de.blinkt.openvpn.LaunchVPN"
            android:exported="false"
            tools:node="merge" />

        <activity
            android:name="de.blinkt.openvpn.api.GrantPermissionsActivity"
            android:exported="false"
            tools:node="merge" />

        <activity
            android:name="de.blinkt.openvpn.api.ConfirmDialog"
            android:exported="false"
            tools:node="merge" />

        <service
            android:name="de.blinkt.openvpn.core.OpenVPNService"
            android:exported="false"
            tools:node="merge" />

        <service
            android:name="de.blinkt.openvpn.api.ExternalOpenVPNService"
            android:exported="false"
            tools:node="merge" />
        <service
            android:name="com.wireguard.android.backend.GoBackend$VpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>


        <receiver
            android:name="de.blinkt.openvpn.OnBootReceiver"
            android:exported="false"
            tools:node="merge" />

        <!-- Receiver для кнопок уведомления об обновлении -->
        <receiver
            android:name=".update.UpdateNotificationReceiver"
            android:exported="false" />

        <!-- Override library FileProvider to avoid conflict with installed OpenVPN app -->
        <provider
            android:name="de.blinkt.openvpn.FileProvider"
            android:authorities="${applicationId}.openvpn.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true"
            tools:node="replace"
            android:screenOrientation="portrait"/>

        <!-- FileProvider для установки APK обновлений -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.update.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

    </application>

</manifest>

