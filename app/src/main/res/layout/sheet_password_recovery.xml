<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="28dp">
        <ImageView android:layout_width="56dp" android:layout_height="56dp"
            android:src="@drawable/ic_email" app:tint="@color/primary"
            android:background="@drawable/bg_recovery_icon" android:padding="14dp"
            android:importantForAccessibility="no" />
        <TextView android:id="@+id/recoveryTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="Восстановить доступ" android:textSize="26sp"
            android:textColor="@color/text_primary" android:textStyle="bold" />
        <TextView android:id="@+id/recoveryDescription" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Укажите email аккаунта. Мы пришлём ссылку, по которой можно задать новый пароль."
            android:textColor="@color/text_secondary" android:textSize="15sp" android:lineSpacingExtra="4dp" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/recoveryEmailLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:hint="Email аккаунта" app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/recoveryEmail"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textEmailAddress" android:maxLines="1" android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/recoveryStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:visibility="gone"
            android:textSize="14sp" android:textColor="@color/text_secondary" android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/recoveryProgress" android:layout_width="32dp"
            android:layout_height="32dp" android:layout_gravity="center" android:layout_marginTop="16dp"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/recoverySend"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp"
            android:text="Отправить ссылку" android:textAllCaps="false" android:textColor="@color/white"
            app:backgroundTint="@color/primary" app:cornerRadius="14dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/recoveryClose"
            style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="Вернуться назад" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
